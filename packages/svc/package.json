{
  "name": "@arth/svc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kafka": {
      "types": "./dist/kafka.d.ts",
      "default": "./dist/kafka.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@platformatic/kafka": "^2.17.0",
    "@sentry/node": "11.15.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3"
  }
}
