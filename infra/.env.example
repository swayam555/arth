# Copy to infra/.env (docker compose reads it from this folder). Never commit infra/.env.
# Every value is optional: the stack runs fully offline with the defaults shown.

# ---- AI keys (the only paid keys) ---------------------------------------
# Copilot LLM. Without it the copilot uses a scripted provider (no real answers).
ANTHROPIC_API_KEY=
# Voice questions (Whisper via Groq). Without it the mic button is unavailable.
GROQ_API_KEY=
# Optional: better RAG embeddings. Set EMBEDDER=voyage as well; default is a local hashing embedder.
VOYAGE_API_KEY=
EMBEDDER=hashing
# auto (Anthropic if its key is set, else scripted) | anthropic | scripted
LLM_PROVIDER=auto

# ---- Push notifications -------------------------------------------------
# log = print pushes to the notifier log; expo = send through Expo push.
PUSH_SENDER=log
EXPO_ACCESS_TOKEN=

# ---- Auth (change both in any shared deployment) ------------------------
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me-dev-only-x
# Leave empty to get a random OTP printed in `docker logs arth-api-1`.
OTP_FIXED_CODE=

# ---- Observability (optional) -------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
OTEL_EXPORT=false
OTEL_ENDPOINT=http://jaeger:4318
GRAFANA_ADMIN_PASSWORD=arth

# ---- Simulator / engine tuning ------------------------------------------
TICK_RATE=2500
NEWS_FEED_URLS=
ALERT_COOLDOWN_SEC=900
DIGEST_SCHEDULER=on
