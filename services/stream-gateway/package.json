{
  "name": "@arth/stream-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --external:uWebSockets.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arth/market": "workspace:*",
    "@arth/svc": "workspace:*",
    "ioredis": "^6.0.0",
    "msgpackr": "^2.1.4",
    "prom-client": "^15.1.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "ws": "^8.23.0",
    "@types/ws": "^8.18.2"
  }
}
