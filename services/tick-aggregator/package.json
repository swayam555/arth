{
  "name": "@arth/tick-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --external:@platformatic/kafka --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arth/market": "workspace:*",
    "@arth/proto": "workspace:*",
    "@arth/svc": "workspace:*",
    "@platformatic/kafka": "^2.17.0",
    "ioredis": "^6.0.0",
    "msgpackr": "^2.1.4",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
