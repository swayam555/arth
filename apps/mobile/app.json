{
  "expo": {
    "name": "Arth",
    "slug": "arth",
    "scheme": "arth",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.arth.app",
      "associatedDomains": [
        "applinks:arth.app"
      ],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Arth uses Face ID to lock the app."
      }
    },
    "android": {
      "package": "in.arth.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "arth.app",
              "pathPrefix": "/instrument"
            },
            {
              "scheme": "https",
              "host": "arth.app",
              "pathPrefix": "/digest"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Arth uses Face ID to lock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Arth uses the microphone only while you dictate a question to the copilot.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B0F14",
          "defaultChannel": "alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
